{
  "name": "optionpulse-workspace",
  "version": "1.0.0",
  "description": "OptionPulse - Indian Stock-Options Market Analysis and Manual Trading Assistant",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": ".\\.venv\\Scripts\\uvicorn.exe backend.main:app --reload --port 8000",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "test": ".\\.venv\\Scripts\\pytest.exe tests/ -v"
  },
  "keywords": [
    "options-trading",
    "nifty",
    "banknifty",
    "technical-analysis",
    "greeks",
    "option-chain"
  ],
