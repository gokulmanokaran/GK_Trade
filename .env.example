# OptionPulse Environment Configuration

# Application
APP_NAME=OptionPulse
ENVIRONMENT=development
PORT=8000

# Database
# Default: SQLite zero-friction development mode
DATABASE_URL=sqlite+aiosqlite:///./optionpulse.db

# PostgreSQL Production example:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/optionpulse

# Redis Caching (optional, defaults to high-performance in-memory cache)
REDIS_URL=redis://localhost:6379/0

# Optional AI Explanation Key (OpenAI / Google Gemini)
# AI_API_KEY=your_key_here

# Market Data Polling Interval (seconds)
DATA_REFRESH_INTERVAL=5
